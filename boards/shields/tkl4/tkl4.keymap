#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp ESC         &kp F2        &kp F4        &kp F6        &kp F8        &kp F10       &kp F12           &kp SCROLLLOCK    &kp LEFT
                &kp F1          &kp F3        &kp F5        &kp F7        &kp F9        &kp F11       &kp PRINTSCREEN   &kp PAUSE_BREAK   &kp DOWN
                &kp GRAVE       &kp N2        &kp N4        &kp N6        &kp N8        &kp N0        &kp EQUAL         &none              &kp RIGHT_CONTROL
                &kp N1          &kp N3        &kp N5        &kp N7        &kp N9        &kp MINUS     &kp BACKSPACE     &kp HOME           &mo 1
                &kp TAB         &kp W         &kp R         &kp Y         &kp I         &kp P         &kp RIGHT_BRACKET &kp END            &kp RIGHT_ALT
                &kp Q           &kp E         &kp T         &kp U         &kp O         &kp LEFT_BRACKET &kp DELETE      &kp PAGE_DOWN      &kp RIGHT_GUI
                &kp A           &kp D         &kp G         &kp J         &kp L         &kp SINGLE_QUOTE &kp ENTER       &kp RIGHT          &kp SPACE
                &kp CAPSLOCK    &kp S         &kp F         &kp H         &kp K         &kp SEMICOLON &kp NUBS          &kp PAGE_UP        &kp LEFT_ALT
                &kp BACKSLASH   &kp X         &kp V         &kp N         &kp COMMA     &kp SLASH     &kp UP            &none              &kp LEFT_GUI
                &kp LEFT_SHIFT  &kp Z         &kp C         &kp B         &kp M         &kp DOT       &kp RIGHT_SHIFT   &none              &kp LEFT_CONTROL
            >;
        };

        bluetooth_layer {
            bindings = <
                &trans          &trans        &trans        &trans        &trans        &trans        &trans            &trans             &trans
                &trans          &trans        &trans        &trans        &trans        &trans        &trans            &trans             &trans
                &trans          &bt BT_SEL 1  &bt BT_SEL 3  &trans        &trans        &trans        &trans            &none              &trans
                &bt BT_SEL 0    &bt BT_SEL 2  &bt BT_SEL 4  &trans        &trans        &trans        &trans            &trans             &trans
                &trans          &trans        &trans        &trans        &trans        &trans        &trans            &trans             &trans
                &trans          &trans        &trans        &trans        &trans        &trans        &bt BT_CLR        &trans             &trans
                &trans          &trans        &trans        &trans        &trans        &trans        &trans            &trans             &trans
                &trans          &trans        &trans        &trans        &trans        &trans        &trans            &trans             &trans
                &trans          &trans        &trans        &trans        &trans        &trans        &trans            &none              &trans
                &trans          &trans        &trans        &trans        &trans        &trans        &trans            &none              &trans
            >;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_bootloader {
            timeout-ms = <100>;
            key-positions = <0 21>;
            bindings = <&bootloader>;
        };
    };
};
